/* =========================================================
   TULESHWAR SAHU — PERSONAL PORTFOLIO
   Premium Dark Classic Interface
   HTML + CSS only
   ========================================================= */


/* ---------- Base ---------- */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #edf1f7;
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(255, 194, 71, 0.08),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 20%,
      rgba(76, 120, 255, 0.08),
      transparent 30%
    ),
    #080a0f;

  line-height: 1.7;
  overflow-x: hidden;
}

body::selection {
  background: rgba(255, 193, 7, 0.35);
  color: white;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

img {
  max-width: 100%;
}


/* ---------- Background ---------- */

.background-glow {
  position: fixed;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(80px);
  opacity: 0.15;
  z-index: -2;
}

.glow-one {
  top: 15%;
  left: -180px;
  background: #d9a62e;
}

.glow-two {
  right: -180px;
  bottom: 15%;
  background: #496cff;
}


/* ---------- Navigation ---------- */

.topbar {
  position: sticky;
  top: 0;
  z-index: 1000;

  background: rgba(8, 10, 15, 0.78);
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.nav-container {
  width: min(1180px, calc(100% - 36px));
  margin: auto;

  min-height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  font-weight: 750;
  letter-spacing: -0.02em;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}

.brand:hover {
  color: #ffd66b;
  transform: translateY(-1px);
}

.brand-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #e7b443;
  box-shadow:
    0 0 12px rgba(231, 180, 67, 0.9),
    0 0 28px rgba(231, 180, 67, 0.35);
}

.navigation {
  display: flex;
  align-items: center;
  gap: 5px;
}

.navigation a {
  padding: 8px 12px;

  color: #aeb5c1;
  font-size: 0.88rem;

  border-radius: 9px;

  transition:
    color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}

.navigation a:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
  transform: translateY(-1px);
}


/* ---------- Common ---------- */

.section {
  width: min(1180px, calc(100% - 36px));
  margin: auto;

  padding: 105px 0;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 16px;

  margin-bottom: 40px;
}

.section-heading span {
  color: #dcb65c;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.section-heading h2 {
  font-size: clamp(1.8rem, 4vw, 2.7rem);
  letter-spacing: -0.04em;
}

.section-intro {
  max-width: 700px;
  margin-top: -20px;
  margin-bottom: 35px;

  color: #8e97a5;
}


/* ---------- Hero ---------- */

.hero {
  min-height: calc(100vh - 72px);

  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  align-items: center;
  gap: 80px;

  padding-top: 80px;
}

.hero-content {
  animation: heroAppear 0.8s ease both;
}

@keyframes heroAppear {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.availability {
  display: inline-flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 28px;
  padding: 7px 12px;

  color: #b9c1cc;
  background: rgba(255, 255, 255, 0.035);

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;

  font-size: 0.78rem;
}

.availability span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #8bcf70;

  box-shadow: 0 0 10px rgba(139, 207, 112, 0.8);
}

.small-heading {
  color: #c9a64d;

  font-size: 0.75rem;
  font-weight: 800;

  letter-spacing: 0.18em;
}

.hero-name {
  margin: 5px 0 18px;

  font-size: clamp(3.4rem, 9vw, 7.5rem);
  line-height: 0.91;

  letter-spacing: -0.07em;
  font-weight: 850;
}

.hero-name span {
  display: block;
}

.hero-name span:last-child {
  color: #d8a93f;

  text-shadow:
    0 0 28px rgba(216, 169, 63, 0.12);
}

.hero-title {
  margin-bottom: 24px;

  color: #d8dde5;
  font-size: clamp(1rem, 2vw, 1.25rem);
}

.hero-title span {
  color: #d5a943;
  margin: 0 7px;
}

.hero-description {
  max-width: 700px;

  color: #9099a7;
  font-size: 1rem;
}

.location {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-top: 20px;

  color: #b9c0ca;
  font-size: 0.9rem;
}

.location-icon {
  color: #d9ac45;
  font-size: 1.1rem;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;

  margin-top: 30px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 46px;
  padding: 0 20px;

  border-radius: 11px;

  font-size: 0.9rem;
  font-weight: 750;

  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    background 0.22s ease,
    border-color 0.22s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.primary-button {
  color: #17130a;

  background: linear-gradient(
    135deg,
    #f0ca68,
    #c99b36
  );

  box-shadow:
    0 8px 28px rgba(205, 158, 48, 0.18);
}

.primary-button:hover {
  box-shadow:
    0 12px 35px rgba(205, 158, 48, 0.28);
}

.secondary-button {
  color: #e7ebf1;

  background: rgba(255, 255, 255, 0.035);

  border: 1px solid rgba(255, 255, 255, 0.12);
}

.secondary-button:hover {
  border-color: rgba(232, 189, 79, 0.4);
  background: rgba(255, 255, 255, 0.06);
}

.quick-links {
  display: flex;
  gap: 20px;

  margin-top: 24px;
}

.quick-links a {
  color: #7f8998;
  font-size: 0.82rem;

  transition: color 0.2s ease;
}

.quick-links a:hover {
  color: #e8bf5c;
}


/* ---------- Profile Card ---------- */

.profile-card {
  position: relative;

  padding: 40px 28px;

  text-align: center;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.075),
      rgba(255, 255, 255, 0.025)
    );

  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.35);

  overflow: hidden;

  animation: cardFloat 5s ease-in-out infinite;
}

.profile-card::before {
  content: "";

  position: absolute;
  width: 170px;
  height: 170px;

  left: 50%;
  top: -110px;

  transform: translateX(-50%);

  border-radius: 50%;

  background: rgba(225, 179, 69, 0.16);
  filter: blur(25px);
}

@keyframes cardFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-7px);
  }
}

.profile-ring {
  position: relative;

  width: 132px;
  height: 132px;

  margin: auto;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #f0ce73,
      #9f7824
    );

  padding: 3px;

  box-shadow:
    0 0 0 8px rgba(222, 177, 68, 0.04),
    0 0 40px rgba(222, 177, 68, 0.14);
}

.profile-letter {
  width: 100%;
  height: 100%;

  display: grid;
  place-items: center;

  border-radius: 50%;

  color: #dcb55a;
  background: #101319;

  font-size: 4rem;
  font-weight: 850;

  transition:
    transform 0.45s ease,
    text-shadow 0.45s ease;
}

.profile-ring:hover .profile-letter {
  transform: rotate(8deg) scale(1.04);

  text-shadow:
    0 0 20px rgba(235, 194, 92, 0.7);
}

.profile-card h2 {
  margin-top: 25px;

  font-size: 1.35rem;
}

.profile-card > p {
  color: #8e97a5;
  font-size: 0.88rem;
}

.card-line {
  width: 55px;
  height: 1px;

  margin: 25px auto;

  background: #c99d3e;
  opacity: 0.55;
}

.card-info {
  display: grid;
  gap: 15px;
  text-align: left;
}

.card-info div {
  display: flex;
  justify-content: space-between;
  gap: 15px;

  padding-bottom: 11px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.card-info span {
  color: #727c8a;
  font-size: 0.78rem;
}

.card-info strong {
  color: #d8dde5;
  font-size: 0.78rem;
}


/* ---------- About ---------- */

.about-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 55px;
}

.about-text {
  color: #9ba4b1;
  font-size: 1rem;
}

.about-text p + p {
  margin-top: 20px;
}

.about-text strong {
  color: #e2e6ed;
}

.info-panel {
  padding: 25px;

  background: rgba(255, 255, 255, 0.025);

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 17px;
}

.info-item {
  display: flex;
  flex-direction: column;

  padding: 17px 0;

  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.info-item:last-child {
  border-bottom: 0;
}

.info-item span {
  color: #6f7887;
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.info-item strong,
.info-item a {
  margin-top: 3px;

  color: #dce1e8;
  font-size: 0.9rem;

  word-break: break-word;
}

.info-item a:hover {
  color: #e4bd5e;
}


/* ---------- Skills ---------- */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 17px;
}

.skill-card {
  padding: 28px;

  background: rgba(255, 255, 255, 0.027);

  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 18px;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;
}

.skill-card:hover {
  transform: translateY(-4px);

  background: rgba(255, 255, 255, 0.045);

  border-color: rgba(226, 184, 78, 0.27);
}

.featured-skill {
  border-color: rgba(226, 184, 78, 0.18);
}

.skill-icon {
  width: 43px;
  height: 43px;

  display: grid;
  place-items: center;

  margin-bottom: 20px;

  color: #e6bd5b;

  background: rgba(224, 180, 73, 0.08);

  border: 1px solid rgba(224, 180, 73, 0.14);
  border-radius: 11px;

  font-weight: 850;
}

.skill-card h3 {
  margin-bottom: 8px;
  font-size: 1.08rem;
}

.skill-card p {
  color: #828c9a;
  font-size: 0.87rem;
}

.skill-tags,
.project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;

  margin-top: 20px;
}

.skill-tags span,
.project-tech span {
  padding: 4px 9px;

  color: #9ca5b2;
  background: rgba(255, 255, 255, 0.045);

  border: 1px solid rgba(255, 255, 255, 0.065);
  border-radius: 7px;

  font-size: 0.72rem;
}

.learning-card {
  border-color: rgba(100, 190, 110, 0.14);
}

.learning-badge {
  display: inline-block;

  margin-top: 18px;
  padding: 5px 10px;

  color: #a9d89a;
  background: rgba(100, 190, 110, 0.08);

  border: 1px solid rgba(100, 190, 110, 0.14);
  border-radius: 999px;

  font-size: 0.7rem;
}


/* ---------- Timeline ---------- */

.timeline {
  position: relative;

  max-width: 850px;
  margin-left: 10px;
}

.timeline::before {
  content: "";

  position: absolute;
  left: 7px;
  top: 9px;
  bottom: 9px;

  width: 1px;

  background:
    linear-gradient(
      to bottom,
      rgba(224, 182, 75, 0.65),
      rgba(255, 255, 255, 0.05)
    );
}

.timeline-item {
  position: relative;

  padding-left: 42px;
  padding-bottom: 40px;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;

  left: 0;
  top: 8px;

  width: 15px;
  height: 15px;

  border-radius: 50%;

  background: #d7ac47;

  box-shadow:
    0 0 0 5px rgba(215, 172, 71, 0.08),
    0 0 16px rgba(215, 172, 71, 0.4);
}

.timeline-label {
  color: #cda849;

  font-size: 0.7rem;
  font-weight: 800;

  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.timeline-content h3 {
  margin: 5px 0 5px;
}

.timeline-content p {
  color: #838d9a;
}


/* ---------- Projects ---------- */

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.project-card {
  min-height: 260px;
  padding: 25px;

  display: flex;
  flex-direction: column;

  background:
    linear-gradient(
      150deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.02)
    );

  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 18px;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease;
}

.project-card:hover {
  transform: translateY(-5px);
  border-color: rgba(224, 181, 73, 0.3);
}

.project-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 28px;
}

.project-number {
  color: #6e7785;
  font-size: 0.75rem;
}

.project-status {
  padding: 4px 8px;

  color: #9aa4b1;
  background: rgba(255, 255, 255, 0.04);

  border-radius: 999px;

  font-size: 0.66rem;
}

.project-card h3 {
  margin-bottom: 10px;
}

.project-card p {
  color: #828c99;
  font-size: 0.85rem;
}

.project-tech {
  margin-top: auto;
  padding-top: 22px;
}

.future-project {
  opacity: 0.82;
}


/* ---------- Resume ---------- */

.resume-card {
  padding: clamp(24px, 5vw, 45px);

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.018)
    );

  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 22px;
}

.resume-header {
  display: flex;
  justify-content: space-between;
  gap: 30px;
}

.resume-label {
  color: #d2a844;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.resume-header h3 {
  margin: 3px 0;

  font-size: 1.8rem;
}

.resume-header p:last-child {
  color: #8b95a3;
}

.resume-contact {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3px;

  color: #818b99;
  font-size: 0.78rem;
  text-align: right;
}

.resume-contact a {
  color: #c6a044;
}

.resume-contact a:hover {
  color: #f0cc69;
}

.resume-divider {
  height: 1px;

  margin: 30px 0;

  background: rgba(255, 255, 255, 0.08);
}

details {
  border-bottom: 1px solid rgba(255, 255, 255, 0.065);
}

details:last-child {
  border-bottom: 0;
}

summary {
  cursor: pointer;

  padding: 20px 0;

  color: #dce1e8;

  font-weight: 700;

  list-style: none;

  transition: color 0.2s ease;
}

summary::-webkit-details-marker {
  display: none;
}

summary::after {
  content: "+";

  float: right;

  color: #cfa94e;

  font-size: 1.2rem;
}

details[open] summary::after {
  content: "−";
}

summary:hover {
  color: #e7bf60;
}

details p,
details ul {
  padding: 0 0 20px;

  color: #838d9a;
  font-size: 0.9rem;
}

details ul {
  padding-left: 20px;
}

details li {
  margin: 5px 0;
}


/* ---------- Contact ---------- */

.contact-card {
  padding: clamp(25px, 5vw, 45px);

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;

  background:
    radial-gradient(
      circle at 85% 50%,
      rgba(222, 177, 68, 0.09),
      transparent 35%
    ),
    rgba(255, 255, 255, 0.025);

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 22px;
}

.contact-text h2 {
  margin: 5px 0;

  font-size: clamp(1.7rem, 4vw, 2.5rem);

  letter-spacing: -0.04em;
}

.contact-text > p:last-child {
  color: #858f9c;
}

.contact-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}


/* ---------- Footer ---------- */

.footer {
  margin-top: 50px;

  border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.footer-inner {
  width: min(1180px, calc(100% - 36px));
  margin: auto;

  min-height: 100px;

  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;

  color: #687281;
  font-size: 0.75rem;
}

.footer-inner div:first-child {
  display: flex;
  flex-direction: column;
}

.footer-inner strong {
  color: #c9ced6;
  font-size: 0.85rem;
}


/* ---------- Back to Top ---------- */

.back-top {
  position: fixed;

  right: 20px;
  bottom: 20px;

  width: 43px;
  height: 43px;

  display: grid;
  place-items: center;

  color: #1a150b;

  background: #dcb251;

  border-radius: 12px;

  font-weight: 900;

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.3);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.back-top:hover {
  transform: translateY(-3px);

  box-shadow:
    0 14px 35px rgba(205, 162, 60, 0.22);
}


/* =========================================================
   RESPONSIVE
   ========================================================= */


/* ---------- Tablet ---------- */

@media (max-width: 900px) {

  .navigation {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    gap: 55px;
  }

  .profile-card {
    max-width: 480px;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .projects-grid {
    grid-template-columns: 1fr 1fr;
  }

}


/* ---------- Mobile ---------- */

@media (max-width: 650px) {

  body {
    font-size: 15px;
  }

  .section {
    width: min(100% - 28px, 1180px);
    padding: 75px 0;
  }

  .nav-container {
    width: calc(100% - 28px);
    min-height: 62px;
  }

  .brand {
    font-size: 0.9rem;
  }

  .hero {
    min-height: auto;
    padding-top: 65px;
  }

  .hero-name {
    font-size: clamp(3.3rem, 18vw, 5rem);
  }

  .hero-title {
    font-size: 0.95rem;
  }

  .hero-description {
    font-size: 0.9rem;
  }

  .hero-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .button {
    width: 100%;
    padding: 0 12px;
  }

  .profile-card {
    padding: 32px 22px;
  }

  .skills-grid {
    grid-template-columns: 1fr;
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }

  .resume-header {
    flex-direction: column;
  }

  .resume-contact {
    align-items: flex-start;
    text-align: left;
  }

  .contact-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .contact-buttons {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
  }

  .footer-inner {
    padding: 25px 0;
    flex-direction: column;
    align-items: flex-start;
  }

  .back-top {
    right: 14px;
    bottom: 14px;
  }

}


/* ---------- Small phones ---------- */

@media (max-width: 390px) {

  .hero-buttons {
    grid-template-columns: 1fr;
  }

  .hero-name {
    font-size: 3.2rem;
  }

  .profile-ring {
    width: 112px;
    height: 112px;
  }

  .profile-letter {
    font-size: 3.3rem;
  }

}


/* ---------- Reduced Motion ---------- */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }

}
