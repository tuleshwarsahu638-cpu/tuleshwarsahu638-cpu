:root {
  --bg: #07090d;
  --bg2: #0c1017;
  --card: rgba(18, 22, 30, 0.88);
  --text: #f4f4f4;
  --muted: #a7adb7;
  --gold: #d4a84f;
  --gold2: #f1d27b;
  --border: rgba(212, 168, 79, 0.25);
  --shadow: 0 20px 60px rgba(0,0,0,.45);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  overflow-x: hidden;

  color: var(--text);

  font-family:
    Inter,
    system-ui,
    -apple-system,
    "Segoe UI",
    sans-serif;

  line-height: 1.7;

  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(212,168,79,.13),
      transparent 35%
    ),
    linear-gradient(
      180deg,
      var(--bg),
      var(--bg2),
      var(--bg)
    );
}

/* GRID BACKGROUND */

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  pointer-events: none;

  background-image:
    linear-gradient(
      rgba(255,255,255,.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.018) 1px,
      transparent 1px
    );

  background-size: 35px 35px;
}

/* GOLDEN PARTICLES */

.particles {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.particles::before,
.particles::after {
  content: "✦  ·   ✧     ·  ✦       ·    ✧   ·";
  position: absolute;

  top: -100px;
  left: 0;

  width: 100%;
  height: 120%;

  color: rgba(212,168,79,.34);

  font-size: 13px;
  letter-spacing: 28px;
  word-spacing: 35px;

  animation: fall 17s linear infinite;
}

.particles::after {
  animation-delay: -8s;
  opacity: .45;
}

@keyframes fall {
  from {
    transform: translateY(-100px);
  }

  to {
    transform: translateY(110vh);
  }
}

/* NAVBAR */

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;

  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 12px 6%;

  background: rgba(7,9,13,.82);

  border-bottom: 1px solid var(--border);

  backdrop-filter: blur(16px);
}

.nav-logo,
.footer-logo,
.hero-avatar {
  display: grid;
  place-items: center;

  font-weight: 900;

  color: var(--gold2);

  border: 1px solid var(--border);

  background:
    radial-gradient(
      circle,
      rgba(212,168,79,.15),
      rgba(212,168,79,.03)
    );

  box-shadow:
    0 0 30px rgba(212,168,79,.08);
}

.nav-logo {
  width: 42px;
  height: 42px;
  border-radius: 12px;
}

.nav-links {
  display: flex;
  gap: 8px;
}

.nav-links a,
.mobile-menu a {
  color: var(--muted);
  text-decoration: none;

  padding: 8px 12px;
  border-radius: 9px;

  transition: .25s;
}

.nav-links a:hover,
.mobile-menu a:hover {
  color: var(--gold2);
  background: rgba(212,168,79,.08);
}

.menu-btn {
  display: none;

  border: 1px solid var(--border);
  background: transparent;

  color: var(--gold2);

  padding: 8px 12px;
  border-radius: 9px;

  font-size: 20px;
}

.mobile-menu {
  display: none;
}

/* HERO */

.hero {
  min-height: 88vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 70px 20px;
}

.classic-badge {
  margin-bottom: 25px;

  padding: 7px 16px;

  color: var(--gold2);

  border: 1px solid var(--border);
  border-radius: 999px;

  background: rgba(212,168,79,.06);

  font-size: 12px;
  letter-spacing: 2px;
}

.hero-avatar {
  width: 105px;
  height: 105px;

  margin-bottom: 24px;

  border-radius: 50%;

  font-size: 34px;

  animation: glow 3s ease-in-out infinite;
}

@keyframes glow {
  50% {
    box-shadow:
      0 0 45px rgba(212,168,79,.22);
  }
}

.hero-small {
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 3px;
}

h1 {
  margin: 10px 0;

  font-size: clamp(2.8rem, 8vw, 6rem);
  line-height: 1;

  letter-spacing: -3px;
}

h1 span {
  color: var(--gold2);
}

.hero h2 {
  color: #d9dde3;
  font-size: clamp(1.1rem, 3vw, 1.7rem);
  font-weight: 500;
}

.hero h2 span {
  color: var(--gold2);
}

.hero-text {
  max-width: 650px;
  margin: 20px auto;

  color: var(--muted);
}

.hero-buttons {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.gold-btn,
.dark-btn {
  text-decoration: none;

  padding: 11px 20px;

  border-radius: 11px;

  transition: .25s;
}

.gold-btn {
  color: #111;

  background:
    linear-gradient(
      135deg,
      var(--gold2),
      var(--gold)
    );

  font-weight: 700;
}

.dark-btn {
  color: var(--gold2);

  border: 1px solid var(--border);
  background: rgba(255,255,255,.025);
}

.gold-btn:hover,
.dark-btn:hover {
  transform: translateY(-3px);
}

/* SECTIONS */

main {
  width: min(1080px, 92%);
  margin: auto;
}

.section {
  margin: 25px 0;
  padding: 34px;

  border: 1px solid var(--border);
  border-radius: 20px;

  background: var(--card);

  box-shadow: var(--shadow);

  backdrop-filter: blur(12px);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 15px;

  margin-bottom: 25px;
}

.section-title span {
  color: var(--gold);
  font-family: monospace;
}

.section-title h2 {
  color: var(--gold2);
  font-size: 1.8rem;
}

/* ABOUT */

.about-card p {
  color: var(--muted);
  margin-bottom: 15px;
}

.about-card strong {
  color: #fff;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 15px;

  margin-top: 25px;
}

.info-box {
  display: flex;
  gap: 13px;

  padding: 17px;

  border: 1px solid rgba(212,168,79,.15);
  border-radius: 13px;

  background: rgba(255,255,255,.025);
}

.info-box span {
  font-size: 22px;
}

.info-box small {
  display: block;
  color: var(--gold);
}

.info-box strong {
  display: block;
  color: #ddd;
}

/* SKILLS */

.skills-grid {
  display: grid;

  grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));

  gap: 15px;
}

.skill-card {
  padding: 22px;

  border: 1px solid rgba(212,168,79,.15);
  border-radius: 15px;

  background: rgba(255,255,255,.025);

  transition: .25s;
}

.skill-card:hover {
  transform: translateY(-5px);

  border-color: rgba(212,168,79,.5);

  box-shadow:
    0 12px 30px rgba(0,0,0,.3);
}

.skill-icon {
  font-size: 28px;
  margin-bottom: 10px;
}

.skill-card h3 {
  margin-bottom: 7px;
}

.skill-card p {
  color: var(--muted);
  font-size: .92rem;
}

.level,
.learning-status,
.project-label {
  display: inline-block;

  margin-top: 12px;
  padding: 5px 10px;

  color: var(--gold2);

  border: 1px solid var(--border);
  border-radius: 999px;

  background: rgba(212,168,79,.06);

  font-size: 11px;
}

/* LEARNING */

.learning-card {
  display: flex;
  align-items: center;
  gap: 20px;

  padding: 25px;

  border: 1px solid var(--border);
  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      rgba(212,168,79,.08),
      rgba(255,255,255,.02)
    );
}

.learning-icon {
  font-size: 45px;
}

.learning-card p {
  color: var(--muted);
}

.progress {
  width: 100%;
  height: 5px;

  margin-top: 15px;

  overflow: hidden;

  border-radius: 10px;
  background: #20252d;
}

.progress-bar {
  width: 45%;
  height: 100%;

  background: linear-gradient(
    90deg,
    var(--gold),
    var(--gold2)
  );
}

/* TIMELINE */

.timeline {
  border-left: 1px solid var(--border);
  padding-left: 25px;
}

.timeline-item {
  position: relative;

  padding-bottom: 25px;
}

.dot {
  position: absolute;

  left: -31px;
  top: 7px;

  width: 11px;
  height: 11px;

  border-radius: 50%;

  background: var(--gold);
  box-shadow: 0 0 15px rgba(212,168,79,.5);
}

.timeline-item p {
  color: var(--muted);
}

/* PROJECT */

.project-card {
  display: flex;
  gap: 22px;
  align-items: center;

  padding: 25px;

  border: 1px solid var(--border);
  border-radius: 16px;

  background: rgba(255,255,255,.025);
}

.project-icon {
  font-size: 45px;
}

.project-content p {
  color: var(--muted);
  margin: 8px 0;
}

.project-content a {
  color: var(--gold2);
  text-decoration: none;
  font-weight: 700;
}

/* CONTACT */

.contact-grid {
  display: grid;

  grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));

  gap: 15px;
}

.contact-card {
  display: flex;
  flex-direction: column;

  padding: 20px;

  text-decoration: none;

  border: 1px solid rgba(212,168,79,.15);
  border-radius: 14px;

  background: rgba(255,255,255,.025);

  transition: .25s;
}

.contact-card:hover {
  transform: translateY(-4px);
  border-color: var(--gold);
}

.contact-card span {
  font-size: 25px;
}

.contact-card small {
  color: var(--gold);
}

.contact-card strong {
  color: #eee;
  word-break: break-word;
}

/* FOOTER */

footer {
  margin-top: 70px;
  padding: 40px 20px;

  text-align: center;

  border-top: 1px solid var(--border);

  background: rgba(0,0,0,.25);
}

.footer-logo {
  width: 50px;
  height: 50px;

  margin: auto auto 12px;

  border-radius: 14px;
}

footer h3 {
  color: var(--gold2);
}

footer p,
footer small {
  color: var(--muted);
}

.footer-line {
  width: 100px;
  height: 1px;

  margin: 18px auto;

  background: var(--border);
}

/* REVEAL */

.reveal {
  opacity: 0;
  transform: translateY(25px);

  transition:
    opacity .7s ease,
    transform .7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* MOBILE */

@media (max-width: 700px) {

  .navbar {
    padding: 10px 4%;
  }

  .nav-links {
    display: none;
  }

  .menu-btn {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    top: 65px;
    right: 15px;
    z-index: 99;

    width: 190px;

    padding: 10px;

    border: 1px solid var(--border);
    border-radius: 14px;

    background: rgba(10,13,18,.97);

    box-shadow: var(--shadow);
  }

  .mobile-menu.open {
    display: flex;
    flex-direction: column;
  }

  .hero {
    min-height: 82vh;
    padding: 50px 15px;
  }

  h1 {
    font-size: clamp(2.5rem, 14vw, 4rem);
  }

  .hero-buttons {
    width: 100%;
    flex-direction: column;
  }

  .gold-btn,
  .dark-btn {
    width: 100%;
  }

  .section {
    padding: 23px 17px;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }

  .learning-card,
  .project-card {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* REDUCE MOTION */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
