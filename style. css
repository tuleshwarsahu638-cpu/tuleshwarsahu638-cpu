/* =========================================================
   TULESHWAR SAHU — PREMIUM CLASSIC PROFILE
   Dark • Classic • Gold • Responsive
   ========================================================= */

:root {
  --bg: #080a0f;
  --bg-soft: #0e1118;
  --card: #11151d;
  --card-2: #151a23;
  --text: #f1f3f5;
  --muted: #aab2bd;
  --gold: #d6a84f;
  --gold-light: #f2d27b;
  --border: rgba(214, 168, 79, 0.24);
  --shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  --radius: 18px;
}

/* ---------- Basic ---------- */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(214, 168, 79, 0.10),
      transparent 35%
    ),
    linear-gradient(
      180deg,
      #07090d 0%,
      #0a0d13 50%,
      #080a0f 100%
    );

  color: var(--text);

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  line-height: 1.7;
  overflow-x: hidden;
}

/* ---------- Classic background ---------- */

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -2;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.018) 1px,
      transparent 1px
    );

  background-size: 32px 32px;
}

/* ---------- Soft golden particles ---------- */

body::after {
  content: "✦   ·     ✧       ·   ✦        ·      ✧   ·     ✦";
  position: fixed;

  top: -80px;
  left: 0;

  width: 100%;
  height: 120vh;

  pointer-events: none;
  z-index: -1;

  color: rgba(214, 168, 79, 0.35);
  font-size: 14px;
  letter-spacing: 34px;
  line-height: 90px;

  white-space: normal;

  transform: translateY(-100px);
  animation: goldenFall 18s linear infinite;
}

@keyframes goldenFall {
  0% {
    transform: translateY(-120px);
    opacity: 0;
  }

  10% {
    opacity: 0.55;
  }

  50% {
    opacity: 0.35;
  }

  90% {
    opacity: 0.5;
  }

  100% {
    transform: translateY(110vh);
    opacity: 0;
  }
}

/* ---------- Main containers ---------- */

main,
.container,
.wrapper {
  width: min(1100px, 92%);
  margin-left: auto;
  margin-right: auto;
}

/* ---------- Header ---------- */

header {
  position: relative;

  padding: 70px 20px 55px;

  text-align: center;

  background:
    linear-gradient(
      180deg,
      rgba(214, 168, 79, 0.07),
      transparent
    );

  border-bottom: 1px solid var(--border);
}

header::after {
  content: "";
  position: absolute;

  left: 50%;
  bottom: -1px;

  width: 140px;
  height: 2px;

  transform: translateX(-50%);

  background: linear-gradient(
    90deg,
    transparent,
    var(--gold),
    transparent
  );
}

/* ---------- Headings ---------- */

h1,
h2,
h3 {
  margin-top: 0;
  color: var(--text);
  line-height: 1.2;
}

h1 {
  font-size: clamp(2.3rem, 7vw, 5rem);
  font-weight: 800;
  letter-spacing: -2px;

  background: linear-gradient(
    135deg,
    #ffffff,
    var(--gold-light),
    #ffffff
  );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;

  text-shadow:
    0 0 30px rgba(214, 168, 79, 0.16);
}

h2 {
  position: relative;

  margin-bottom: 25px;

  font-size: clamp(1.7rem, 4vw, 2.5rem);
  color: var(--gold-light);
}

h3 {
  color: #f5f5f5;
}

/* ---------- Paragraphs ---------- */

p {
  color: var(--muted);
  font-size: 1rem;
}

/* ---------- Links ---------- */

a {
  color: var(--gold-light);
  text-decoration: none;

  transition:
    color 0.25s ease,
    transform 0.25s ease,
    opacity 0.25s ease;
}

a:hover {
  color: #ffffff;
}

/* ---------- Sections ---------- */

section {
  position: relative;

  margin: 28px auto;
  padding: 32px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.012)
    );

  border: 1px solid var(--border);
  border-radius: var(--radius);

  box-shadow: var(--shadow);

  backdrop-filter: blur(12px);
}

/* ---------- Cards ---------- */

.card,
article,
.project,
.skill,
.project-card {
  background: var(--card);

  border: 1px solid rgba(214, 168, 79, 0.16);
  border-radius: 15px;

  padding: 22px;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.card:hover,
article:hover,
.project:hover,
.skill:hover,
.project-card:hover {
  transform: translateY(-4px);

  border-color: rgba(214, 168, 79, 0.48);

  box-shadow:
    0 12px 35px rgba(0, 0, 0, 0.35),
    0 0 25px rgba(214, 168, 79, 0.07);
}

/* ---------- Lists ---------- */

ul {
  padding-left: 25px;
}

li {
  margin: 9px 0;
  color: var(--muted);
}

li::marker {
  color: var(--gold);
}

/* ---------- Buttons ---------- */

button,
.btn,
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 44px;
  padding: 10px 20px;

  border: 1px solid rgba(214, 168, 79, 0.45);
  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      rgba(214, 168, 79, 0.16),
      rgba(214, 168, 79, 0.05)
    );

  color: var(--gold-light);

  cursor: pointer;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

button:hover,
.btn:hover,
.button:hover {
  transform: translateY(-2px);

  background:
    linear-gradient(
      135deg,
      rgba(214, 168, 79, 0.28),
      rgba(214, 168, 79, 0.08)
    );

  box-shadow:
    0 8px 25px rgba(214, 168, 79, 0.12);
}

button.clicked,
.btn.clicked,
.button.clicked {
  transform: scale(0.96);
}

/* ---------- Navigation ---------- */

nav {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;

  gap: 10px;

  padding: 15px 20px;

  background: rgba(8, 10, 15, 0.88);

  border-bottom: 1px solid var(--border);

  backdrop-filter: blur(14px);

  position: sticky;
  top: 0;
  z-index: 100;
}

nav a,
.nav-link {
  padding: 8px 14px;

  border-radius: 10px;

  color: var(--muted);

  transition: 0.25s ease;
}

nav a:hover,
nav a.active,
.nav-link:hover,
.nav-link.active {
  color: var(--gold-light);

  background: rgba(214, 168, 79, 0.08);
}

/* ---------- Hero ---------- */

.hero {
  min-height: 60vh;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  padding: 70px 20px;
}

.hero p {
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
}

/* ---------- Classic game-style badge ---------- */

.classic-game,
.game-badge,
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 20px;

  padding: 7px 14px;

  border: 1px solid rgba(214, 168, 79, 0.35);
  border-radius: 999px;

  background: rgba(214, 168, 79, 0.07);

  color: var(--gold-light);

  font-size: 0.82rem;
  letter-spacing: 1.5px;

  box-shadow:
    0 0 20px rgba(214, 168, 79, 0.05);
}

/* ---------- Profile image ---------- */

img {
  max-width: 100%;
  height: auto;
}

.profile-image,
.avatar,
.profile-photo {
  border-radius: 50%;

  border: 2px solid rgba(214, 168, 79, 0.55);

  box-shadow:
    0 0 0 6px rgba(214, 168, 79, 0.04),
    0 0 35px rgba(214, 168, 79, 0.12);
}

/* ---------- Skills ---------- */

.skills,
.skill-list,
.projects,
.project-grid {
  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(220px, 1fr));

  gap: 16px;
}

/* ---------- Skill tags ---------- */

.tag,
.skill-tag,
.tech {
  display: inline-block;

  margin: 5px;

  padding: 7px 12px;

  border: 1px solid rgba(214, 168, 79, 0.22);
  border-radius: 999px;

  background: rgba(214, 168, 79, 0.055);

  color: var(--muted);

  font-size: 0.88rem;
}

/* ---------- Project links ---------- */

.project a,
.project-card a {
  color: var(--gold-light);
  font-weight: 600;
}

/* ---------- Contact ---------- */

.contact {
  text-align: center;
}

.contact a {
  display: inline-block;
  margin: 6px;
}

/* ---------- Footer ---------- */

footer {
  margin-top: 60px;
  padding: 35px 20px;

  text-align: center;

  color: #7f8792;

  border-top: 1px solid var(--border);

  background: rgba(0, 0, 0, 0.18);
}

/* ---------- Scroll reveal ---------- */

.reveal,
.fade-in,
.animate-on-scroll,
[data-reveal] {
  opacity: 0;
  transform: translateY(18px);

  transition:
    opacity 0.7s ease,
    transform 0.7s ease;
}

.reveal.visible,
.fade-in.visible,
.animate-on-scroll.visible,
[data-reveal].visible {
  opacity: 1;
  transform: translateY(0);
}

/* ---------- Back to top ---------- */

.back-to-top,
#backToTop,
[data-back-to-top] {
  opacity: 0;
  pointer-events: none;

  position: fixed;

  right: 20px;
  bottom: 20px;

  z-index: 200;
}

.back-to-top.show,
#backToTop.show,
[data-back-to-top].show {
  opacity: 1;
  pointer-events: auto;
}

/* ---------- Mobile menu ---------- */

.mobile-menu {
  display: none;
}

.mobile-menu.active {
  display: block;
}

/* ---------- Selection ---------- */

::selection {
  background: rgba(214, 168, 79, 0.28);
  color: #ffffff;
}

/* ---------- Scrollbar ---------- */

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #080a0f;
}

::-webkit-scrollbar-thumb {
  background: rgba(214, 168, 79, 0.35);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(214, 168, 79, 0.55);
}

/* ---------- Tablet ---------- */

@media (max-width: 800px) {

  section {
    padding: 25px 20px;
  }

  .hero {
    min-height: 55vh;
    padding: 55px 18px;
  }

  nav {
    gap: 5px;
  }

  nav a,
  .nav-link {
    padding: 7px 10px;
    font-size: 0.9rem;
  }
}

/* ---------- Phone ---------- */

@media (max-width: 600px) {

  body {
    font-size: 15px;
  }

  header {
    padding: 50px 16px 40px;
  }

  h1 {
    font-size: clamp(2.1rem, 12vw, 3.5rem);
    letter-spacing: -1px;
  }

  h2 {
    font-size: 1.65rem;
  }

  section {
    width: 94%;
    margin: 18px auto;
    padding: 22px 17px;
    border-radius: 15px;
  }

  .hero {
    min-height: 50vh;
    padding: 50px 15px;
  }

  .skills,
  .skill-list,
  .projects,
  .project-grid {
    grid-template-columns: 1fr;
  }

  .card,
  article,
  .project,
  .skill,
  .project-card {
    padding: 18px;
  }

  button,
  .btn,
  .button {
    width: 100%;
  }

  nav {
    position: relative;
  }

  body::after {
    font-size: 10px;
    letter-spacing: 20px;
  }
}

/* ---------- Reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
} q
