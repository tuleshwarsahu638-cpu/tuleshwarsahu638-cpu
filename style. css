/* =========================================================
   TULESHWAR SAHU — PREMIUM DARK CLASSIC PORTFOLIO
   File: style.css

   Easy editing:
   - Main background: #090b10
   - Gold accent: #d6ad55
   - Card background: #11141b
   - Text: #f2f2f2
========================================================= */


/* =========================================================
   1. BASIC RESET
========================================================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Arial,
    sans-serif;

  background: #090b10 !important;
  color: #f2f2f2 !important;

  line-height: 1.6;
  overflow-x: hidden;
}

a {
  text-decoration: none;
  color: inherit;
}


/* =========================================================
   2. SELECTION
========================================================= */

::selection {
  background: #d6ad55;
  color: #080808;
}


/* =========================================================
   3. HEADER
========================================================= */

.site-header,
nav {
  position: sticky;
  top: 0;
  z-index: 1000;

  width: 100%;

  background:
    rgba(9, 11, 16, 0.90) !important;

  border-bottom: 1px solid #252a33;

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}


/* =========================================================
   4. NAVIGATION
========================================================= */

.navbar,
.nav-container {
  width: min(1120px, 100%);

  margin: auto;

  padding: 17px 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand,
.logo {
  font-size: 20px;
  font-weight: 750;

  letter-spacing: -0.3px;

  color: #ffffff !important;

  transition:
    transform 0.3s ease,
    color 0.3s ease;
}

.brand span,
.logo span {
  color: #d6ad55 !important;
}

.brand:hover,
.logo:hover {
  transform: translateY(-1px);
}

.nav-links {
  display: flex;

  align-items: center;

  gap: 22px;

  list-style: none;
}

.nav-links a {
  position: relative;

  color: #bfc3ca !important;

  font-size: 14px;

  transition:
    color 0.3s ease,
    transform 0.3s ease;
}

.nav-links a::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -7px;

  width: 0;
  height: 1px;

  background: #d6ad55;

  transition: width 0.3s ease;
}

.nav-links a:hover {
  color: #d6ad55 !important;
}

.nav-links a:hover::after {
  width: 100%;
}


/* =========================================================
   5. HERO SECTION
========================================================= */

.hero {
  position: relative;

  min-height: 88vh;

  display: flex;

  justify-content: center;
  align-items: center;

  text-align: center;

  padding:
    90px 22px
    80px;

  overflow: hidden;
}


/* Soft background glow */

.hero::before {
  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  top: 10%;
  left: 50%;

  transform: translateX(-50%);

  background:
    radial-gradient(
      circle,
      rgba(214, 173, 85, 0.10),
      transparent 68%
    );

  pointer-events: none;
}


/* Small background glow */

.hero::after {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  top: 20%;
  left: 8%;

  background:
    radial-gradient(
      circle,
      rgba(255, 255, 255, 0.035),
      transparent 70%
    );

  pointer-events: none;
}


/* =========================================================
   6. HERO CONTENT
========================================================= */

.hero-content {
  position: relative;

  z-index: 2;

  width: 100%;

  max-width: 900px;

  margin: auto;
}

.hello {
  margin-bottom: 13px;

  color: #9b9da3 !important;

  font-size: 14px;

  letter-spacing: 3px;

  text-transform: uppercase;
}

.hero h1,
#name {
  display: inline-block;

  margin-bottom: 18px;

  font-size:
    clamp(45px, 8vw, 86px);

  line-height: 1.05;

  font-weight: 800;

  letter-spacing: -3px;

  cursor: pointer;

  background:
    linear-gradient(
      90deg,
      #ffffff 0%,
      #ffffff 35%,
      #d6ad55 50%,
      #ffffff 65%,
      #ffffff 100%
    );

  background-size: 220% auto;

  -webkit-background-clip: text;
  background-clip: text;

  -webkit-text-fill-color: transparent;

  animation:
    nameShine 6s linear infinite;

  transition:
    transform 0.3s ease,
    filter 0.3s ease;
}

#name:hover {
  transform: translateY(-3px) scale(1.01);

  filter:
    drop-shadow(
      0 0 22px
      rgba(214, 173, 85, 0.18)
    );
}

@keyframes nameShine {

  0% {
    background-position: 0% center;
  }

  100% {
    background-position: 220% center;
  }

}

.hero h2 {
  margin-bottom: 14px;

  color: #d7d8dc !important;

  font-size:
    clamp(20px, 4vw, 30px);

  font-weight: 400;
}

.hero p {
  color: #a9abb1 !important;

  font-size: 16px;
}

.location {
  margin-top: 14px;

  color: #d6ad55 !important;

  font-size: 14px !important;
}


/* =========================================================
   7. BUTTONS
========================================================= */

.buttons,
.hero-buttons {
  margin-top: 30px;

  display: flex;

  justify-content: center;

  align-items: center;

  gap: 12px;

  flex-wrap: wrap;
}

.btn,
.button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 46px;

  padding:
    11px 20px;

  border:
    1px solid #363c47;

  border-radius: 9px;

  background:
    rgba(19, 22, 29, 0.9);

  color: #eeeeee !important;

  font-size: 14px;

  font-weight: 600;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease;
}

.btn:hover,
.button:hover {
  transform: translateY(-3px);

  border-color: #d6ad55;

  color: #d6ad55 !important;

  background: #171a21;

  box-shadow:
    0 10px 30px
    rgba(0, 0, 0, 0.22);
}

.btn-primary,
.button.primary {
  background: #d6ad55 !important;

  border-color: #d6ad55 !important;

  color: #0b0c0f !important;
}

.btn-primary:hover,
.button.primary:hover {
  background: #e2c274 !important;

  color: #08090b !important;
}


/* =========================================================
   8. NAME HINT
========================================================= */

.name-hint {
  margin-top: 22px;

  font-size: 12px !important;

  color: #666b74 !important;

  letter-spacing: 1px;
}


/* =========================================================
   9. GENERAL SECTIONS
========================================================= */

section {
  width: min(1100px, 100%);

  margin: auto;

  padding:
    95px 22px;
}

.section {
  scroll-margin-top: 80px;
}

.section-title,
.section-heading {
  margin-bottom: 35px;
}

.section-title {
  font-size: 30px;

  border-left:
    3px solid #d6ad55;

  padding-left: 14px;
}

.section-heading {
  display: flex;

  align-items: center;

  gap: 12px;
}

.section-heading span {
  color: #d6ad55;

  font-family: monospace;

  font-size: 13px;

  opacity: 0.9;
}

.section-heading h2 {
  font-size:
    clamp(27px, 5vw, 36px);

  font-weight: 700;

  color: #f1f1f1;
}


/* =========================================================
   10. CONTENT CARD
========================================================= */

.content-card {
  position: relative;

  padding: 30px;

  border:
    1px solid #292e38;

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      #12151b,
      #0d0f14
    );

  box-shadow:
    0 20px 60px
    rgba(0, 0, 0, 0.18);

  overflow: hidden;
}

.content-card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #d6ad55,
      transparent
    );

  opacity: 0.55;
}

.content-card p {
  margin-bottom: 14px;

  color: #b5b8be !important;

  font-size: 16px;
}

.content-card p:last-child {
  margin-bottom: 0;
}

.content-card strong {
  color: #ffffff;
}


/* =========================================================
   11. SKILLS
========================================================= */

.skill-category {
  margin-bottom: 38px;
}

.skill-category h3 {
  margin-bottom: 16px;

  color: #d6ad55;

  font-size: 16px;

  font-weight: 650;
}

.skills,
.skill-grid {
  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(145px, 1fr));

  gap: 12px;
}

.skill,
.skill-card {
  min-height: 64px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  text-align: center;

  padding: 12px;

  border:
    1px solid #2b3039;

  border-radius: 11px;

  background:
    linear-gradient(
      145deg,
      #12151c,
      #0e1015
    );

  color: #d7d8dc !important;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.skill:hover,
.skill-card:hover {
  transform:
    translateY(-4px);

  border-color:
    rgba(214, 173, 85, 0.65);

  box-shadow:
    0 12px 30px
    rgba(0, 0, 0, 0.22);
}

.skill-card strong {
  font-size: 17px;

  color: #ffffff;
}

.skill-card small {
  margin-top: 3px;

  color: #d6ad55;
}


/* =========================================================
   12. TIMELINE / EDUCATION
========================================================= */

.timeline {
  position: relative;

  display: flex;

  flex-direction: column;

  gap: 18px;
}

.timeline-item {
  display: flex;

  align-items: center;

  gap: 18px;

  padding: 22px;

  border:
    1px solid #292e38;

  border-radius: 12px;

  background: #11141a;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease;
}

.timeline-item:hover {
  transform: translateX(4px);

  border-color:
    rgba(214, 173, 85, 0.6);
}

.timeline-number {
  min-width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  border:
    1px solid #d6ad55;

  border-radius: 50%;

  color: #d6ad55;

  font-family: monospace;
}

.timeline-item h3 {
  margin-bottom: 3px;

  color: #ffffff;
}

.timeline-item p {
  color: #8f939b;
}


/* =========================================================
   13. LEARNING CARD
========================================================= */

.learning-card {
  display: flex;

  align-items: center;

  gap: 20px;

  padding: 28px;

  border:
    1px solid #2b3039;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #14171e,
      #0f1117
    );

  transition:
    transform 0.3s ease,
    border-color 0.3s ease;
}

.learning-card:hover {
  transform: translateY(-4px);

  border-color:
    rgba(214, 173, 85, 0.7);
}

.learning-icon {
  width: 58px;
  height: 58px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background:
    rgba(214, 173, 85, 0.10);

  border:
    1px solid
    rgba(214, 173, 85, 0.4);

  font-size: 26px;
}

.learning-card h3 {
  margin-bottom: 5px;

  color: #ffffff;
}

.learning-card p {
  color: #9ea2aa;

  font-size: 14px;
}


/* =========================================================
   14. PROJECT CARD
========================================================= */

.project-card {
  position: relative;

  padding: 30px;

  border:
    1px solid #2b3039;

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #14171e,
      #0e1015
    );

  overflow: hidden;

  transition:
    transform 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.project-card::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  right: -80px;
  top: -80px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(214, 173, 85, 0.10),
      transparent 70%
    );
}

.project-card:hover {
  transform:
    translateY(-5px);

  border-color:
    rgba(214, 173, 85, 0.7);

  box-shadow:
    0 18px 45px
    rgba(0, 0, 0, 0.25);
}

.project-top {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 18px;
}

.project-number {
  color: #d6ad55;

  font-family: monospace;

  font-size: 12px;

  letter-spacing: 1px;
}

.project-icon {
  font-size: 28px;
}

.project-card h3 {
  margin-bottom: 10px;

  font-size: 24px;

  color: #ffffff;
}

.project-card p {
  max-width: 720px;

  color: #a2a6ae;

  margin-bottom: 20px;
}

.project-link {
  display: inline-block;

  color: #d6ad55 !important;

  font-weight: 650;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}

.project-link:hover {
  color: #f0d58d !important;

  transform:
    translateX(4px);
}


/* =========================================================
   15. CONTACT
========================================================= */

.contact-card {
  padding: 35px;

  border:
    1px solid #2b3039;

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #14171e,
      #0e1015
    );
}

.contact-card h3 {
  margin-bottom: 10px;

  color: #ffffff;

  font-size: 25px;
}

.contact-card > p {
  max-width: 700px;

  margin-bottom: 25px;

  color: #9da1a8;
}

.contact-details {
  display: grid;

  gap: 10px;

  padding: 20px;

  margin-bottom: 10px;

  border-radius: 10px;

  background: #0b0e13;

  border:
    1px solid #252a33;
}

.contact-details p {
  color: #bfc2c8;
}

.contact-details strong {
  display: inline-block;

  min-width: 95px;

  color: #d6ad55;
}

.contact-details a {
  color: #ffffff;

  word-break: break-word;
}

.contact-details a:hover {
  color: #d6ad55;
}


/* =========================================================
   16. FOOTER
========================================================= */

footer {
  padding:
    38px 20px;

  text-align: center;

  border-top:
    1px solid #252a33;

  color: #777c85;
}

footer p {
  margin-bottom: 5px;
}

footer strong {
  color: #d6ad55;
}


/* =========================================================
   17. GOLD PARTICLES
========================================================= */

.particle {
  position: fixed !important;

  width: 4px !important;
  height: 4px !important;

  border-radius: 50% !important;

  background:
    #d6ad55 !important;

  box-shadow:
    0 0 8px
    rgba(214, 173, 85, 0.8);

  pointer-events: none;

  z-index: 99999;

  animation:
    goldFall 1.8s ease-out forwards;
}

@keyframes goldFall {

  0% {
    opacity: 1;

    transform:
      translateY(0)
      translateX(0)
      scale(1);
  }

  30% {
    opacity: 1;
  }

  100% {
    opacity: 0;

    transform:
      translateY(190px)
      translateX(var(--particle-x, 0px))
      scale(0.15);
  }

}


/* =========================================================
   18. MOBILE
========================================================= */

@media (max-width: 700px) {

  .navbar,
  .nav-container {
    padding:
      14px 16px;
  }

  .nav-links {
    display: none !important;
  }

  .brand,
  .logo {
    font-size: 18px;
  }

  .hero {
    min-height: 84vh;

    padding:
      75px 18px
      60px;
  }

  .hero h1,
  #name {
    font-size:
      clamp(42px, 13vw, 62px);

    letter-spacing:
      -2px;
  }

  .hero h2 {
    font-size: 21px;
  }

  .hero p {
    font-size: 14px;
  }

  section {
    padding:
      70px 17px;
  }

  .section-heading {
    margin-bottom: 25px;
  }

  .section-heading h2 {
    font-size: 28px;
  }

  .content-card,
  .project-card,
  .contact-card {
    padding: 22px;
  }

  .skill-grid,
  .skills {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .skill-card,
  .skill {
    min-height: 58px;

    font-size: 13px;

    padding: 9px;
  }

  .learning-card {
    align-items: flex-start;

    padding: 22px;
  }

  .timeline-item {
    padding: 18px;
  }

  .buttons,
  .hero-buttons {
    gap: 9px;
  }

  .btn,
  .button {
    min-height: 44px;

    padding:
      10px 16px;

    font-size: 13px;
  }

}


/* =========================================================
   19. VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

  .skill-grid,
  .skills {
    grid-template-columns: 1fr;
  }

  .hero h1,
  #name {
    font-size: 39px;
  }

  .hero h2 {
    font-size: 19px;
  }

  .btn,
  .button {
    width: 100%;
  }

}


/* =========================================================
   20. REDUCE ANIMATION FOR ACCESSIBILITY
========================================================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration:
      0.01ms !important;

    animation-iteration-count:
      1 !important;

    scroll-behavior:
      auto !important;

    transition-duration:
      0.01ms !important;
  }

}
