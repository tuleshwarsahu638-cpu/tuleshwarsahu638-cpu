@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #090d18;
  --panel: rgba(17, 24, 43, .78);
  --panel-solid: #11182b;
  --line: rgba(167, 184, 220, .15);
  --text: #f1f5ff;
  --muted: #a5b0c9;
  --accent: #8b7cff;
  --accent-two: #5de0c2;
  --radius: 22px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body { margin: 0; background: var(--bg); color: var(--text); font-family: 'Manrope', system-ui, sans-serif; line-height: 1.65; overflow-x: hidden; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }
::selection { background: rgba(139,124,255,.35); }
.ambient { position: fixed; width: 420px; height: 420px; border-radius: 50%; filter: blur(110px); opacity: .13; pointer-events: none; z-index: -1; }
.ambient-one { background: #7566ff; top: -170px; right: -140px; }
.ambient-two { background: #37c9b0; top: 800px; left: -240px; }
.topbar { width: min(1160px, calc(100% - 44px)); margin: 0 auto; min-height: 82px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
.brand { display: flex; align-items: center; gap: 12px; font-weight: 800; letter-spacing: -.03em; }
.brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgba(139,124,255,.5); border-radius: 12px; color: var(--accent-two); background: rgba(139,124,255,.1); font-family: 'DM Mono', monospace; font-size: .82rem; }
.nav-links { display: flex; align-items: center; gap: 26px; color: var(--muted); font-size: .84rem; }
.nav-links a { transition: color .2s ease; }
.nav-links a:hover, .footer a:hover { color: var(--accent-two); }
.menu-toggle { display: none; border: 1px solid var(--line); background: var(--panel); color: var(--text); border-radius: 10px; padding: 7px 11px; }
.section-shell { width: min(1080px, calc(100% - 44px)); margin-inline: auto; }
.hero { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: 60px; padding-top: 94px; padding-bottom: 100px; min-height: 610px; }
.eyebrow, .section-kicker, .project-label, .hero-card-label { color: var(--accent-two); font-family: 'DM Mono', monospace; letter-spacing: .13em; font-size: .7rem; }
.eyebrow { display: flex; align-items: center; gap: 10px; }
.status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-two); box-shadow: 0 0 13px var(--accent-two); }
h1 { font-size: clamp(2.8rem, 6vw, 5.2rem); line-height: 1.08; letter-spacing: -.075em; margin: 23px 0 22px; max-width: 720px; }
.gradient-text { background: linear-gradient(100deg, #a9a0ff 5%, #6ce8d1 95%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero-subtitle { max-width: 540px; color: var(--muted); font-size: 1.08rem; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 46px; padding: 0 18px; border-radius: 12px; font-size: .84rem; font-weight: 800; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
.button:hover { transform: translateY(-3px); }
.button-primary { background: linear-gradient(115deg, #8273ff, #5a9fcb); color: #fff; box-shadow: 0 9px 28px rgba(100, 107, 255, .18); }
.button-secondary { border: 1px solid var(--line); background: rgba(255,255,255,.025); color: var(--text); }
.button-secondary:hover { border-color: rgba(93,224,194,.55); }
.quick-facts { display: flex; flex-wrap: wrap; gap: 32px; margin-top: 48px; }
.quick-facts > div { display: flex; flex-direction: column; gap: 2px; }
.fact-number { font-size: 1.2rem; font-weight: 800; letter-spacing: -.04em; }
.fact-label { color: var(--muted); font-size: .72rem; }
.hero-card { position: relative; overflow: hidden; padding: 36px; min-height: 360px; border: 1px solid var(--line); border-radius: 28px; background: linear-gradient(145deg, rgba(24,33,57,.95), rgba(13,19,34,.8)); box-shadow: 0 25px 80px rgba(0,0,0,.2); }
.hero-card::before { content: ''; position: absolute; width: 230px; height: 230px; border-radius: 50%; background: rgba(139,124,255,.15); filter: blur(60px); top: -110px; right: -60px; }
.avatar-placeholder { display: grid; place-items: center; width: 74px; height: 74px; border-radius: 24px; border: 1px solid rgba(93,224,194,.4); background: linear-gradient(135deg, rgba(139,124,255,.22), rgba(93,224,194,.12)); color: var(--accent-two); font-size: 1.25rem; font-weight: 800; position: relative; }
.hero-card-label { margin-top: 28px; }
.hero-card h2 { font-size: 1.85rem; line-height: 1.25; letter-spacing: -.06em; margin: 12px 0; position: relative; }
.hero-card p { color: var(--muted); font-size: .9rem; max-width: 300px; }
.mini-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 20px; }
.mini-tags span, .tool-chips span { border: 1px solid var(--line); border-radius: 100px; padding: 6px 10px; font-size: .72rem; color: #c8d0e5; background: rgba(255,255,255,.025); }
.card-orbit { position: absolute; border: 1px solid rgba(139,124,255,.13); border-radius: 50%; width: 230px; height: 230px; right: -105px; bottom: -110px; }
.orbit-b { width: 170px; height: 170px; right: -75px; bottom: -80px; border-color: rgba(93,224,194,.14); }
.content-section { padding-top: 48px; padding-bottom: 50px; }
.section-heading { margin-bottom: 28px; }
.section-kicker { display: block; margin-bottom: 10px; color: #8e9ab8; }
.section-heading h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -.065em; margin: 0; }
.about-panel { display: flex; gap: 22px; align-items: flex-start; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
.about-icon { flex: 0 0 42px; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 13px; color: var(--accent-two); background: rgba(93,224,194,.09); font-size: 1.25rem; }
.about-panel p { margin: 0; color: #d0d8eb; max-width: 800px; font-size: 1.02rem; }
.skills-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.skill-card, .qualification-card { padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); }
.skill-card { transition: transform .25s ease, border-color .25s ease; }
.skill-card:hover, .qualification-card:hover { transform: translateY(-4px); border-color: rgba(139,124,255,.42); }
.skill-card-top { display: flex; align-items: center; justify-content: space-between; }
.skill-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: rgba(139,124,255,.12); color: #b9b0ff; font-family: 'DM Mono', monospace; }
.skill-index { color: #68748f; font-family: 'DM Mono', monospace; font-size: .72rem; }
.skill-card h3, .qualification-card h3 { font-size: 1rem; margin: 20px 0 14px; letter-spacing: -.025em; }
.skill-list { display: grid; gap: 10px; }
.skill-list span, .qual-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: var(--muted); font-size: .8rem; }
.skill-list b, .qual-row b { font-size: .67rem; color: var(--accent-two); font-weight: 600; border: 1px solid rgba(93,224,194,.2); background: rgba(93,224,194,.06); border-radius: 6px; padding: 3px 6px; white-space: nowrap; }
.project-card { display: grid; grid-template-columns: .9fr 1.1fr; gap: 36px; padding: 28px; border: 1px solid var(--line); border-radius: 24px; background: linear-gradient(140deg, rgba(18,26,46,.96), rgba(13,18,32,.85)); }
.project-visual { display: grid; place-items: center; min-height: 320px; border: 1px solid rgba(139,124,255,.15); border-radius: 18px; background: radial-gradient(circle at 50% 35%, rgba(115,101,255,.17), transparent 65%), rgba(4,8,17,.45); overflow: hidden; }
.calculator-window { width: min(250px, 85%); padding: 12px; border-radius: 15px; border: 1px solid rgba(180,190,230,.18); background: #0c1221; box-shadow: 0 22px 50px rgba(0,0,0,.35); transform: rotate(-3deg); }
.calc-top { display: flex; align-items: center; gap: 4px; padding: 3px 3px 12px; color: #8e9ab8; font-family: 'DM Mono', monospace; font-size: .48rem; }
.calc-top i { width: 6px; height: 6px; border-radius: 50%; background: #7e8aa7; }
.calc-top span { margin-left: auto; }
.calc-screen { min-height: 72px; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; padding: 10px; border-radius: 8px; background: #121c30; color: #9ba9c6; font-family: 'DM Mono', monospace; font-size: .72rem; }
.calc-screen span { color: #eaf0ff; font-size: 1.35rem; }
.calc-keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; margin-top: 8px; }
.calc-keys b { display: grid; place-items: center; min-height: 30px; border-radius: 6px; background: #1b2740; color: #cbd5ed; font-family: 'DM Mono', monospace; font-size: .7rem; font-weight: 400; }
.calc-keys b:nth-child(4n), .calc-keys b:last-child { background: #5c60b7; color: white; }
.calc-keys .wide { grid-column: span 2; }
.project-details { padding: 8px 0; }
.project-label { color: var(--accent-two); }
.project-details h3 { font-size: 1.75rem; letter-spacing: -.06em; margin: 10px 0; }
.project-details h3 span { color: #8e9ab8; font-size: 1rem; font-weight: 500; }
.project-details p { color: var(--muted); font-size: .9rem; }
.project-details h4 { margin: 20px 0 8px; font-size: .83rem; }
.project-points { display: grid; grid-template-columns: 1fr 1fr; gap: 9px 18px; padding: 0; margin: 0; list-style: none; color: #c4cde1; font-size: .77rem; }
.project-points li::before { content: '↗'; color: var(--accent-two); margin-right: 7px; }
.project-note { border-left: 2px solid var(--accent); padding-left: 12px; margin-top: 22px; color: #8e9ab8; font-size: .72rem; }
.timeline { display: grid; gap: 14px; max-width: 780px; }
.timeline-item { display: grid; grid-template-columns: 16px 1fr; gap: 16px; }
.timeline-marker { width: 10px; height: 10px; margin-top: 27px; border-radius: 50%; background: var(--accent-two); box-shadow: 0 0 0 5px rgba(93,224,194,.09); }
.timeline-card { border: 1px solid var(--line); border-radius: 16px; padding: 20px 24px; background: var(--panel); }
.timeline-label { color: var(--accent-two); font-family: 'DM Mono', monospace; font-size: .7rem; }
.timeline-card h3 { margin: 5px 0 3px; font-size: 1rem; }
.timeline-card p { margin: 0; color: var(--muted); font-size: .82rem; }
.qualification-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.qualification-card { transition: transform .25s ease, border-color .25s ease; }
.qual-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 13px; color: var(--accent-two); background: rgba(93,224,194,.08); font-size: 1.2rem; }
.qualification-card h3 { margin: 15px 0 18px; }
.qual-row { padding: 10px 0; border-top: 1px solid rgba(167,184,220,.08); }
.qual-row em { color: #c2b7ff; font-size: .68rem; font-style: normal; }
.tool-chips { display: flex; flex-wrap: wrap; gap: 10px; }
.tool-chips span { display: inline-flex; align-items: center; gap: 9px; padding: 9px 13px; }
.tool-chips b { font-size: .62rem; font-weight: 500; color: var(--accent-two); }
.interest-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
.interest-grid span { display: flex; flex-direction: column; gap: 12px; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--panel); color: var(--accent-two); font-size: 1.2rem; }
.interest-grid b { color: #cbd4e8; font-size: .75rem; font-weight: 600; }
.contact-section { margin-top: 80px; margin-bottom: 75px; padding: 52px 24px; text-align: center; border: 1px solid rgba(139,124,255,.2); border-radius: 26px; background: radial-gradient(circle at 50% 0%, rgba(139,124,255,.12), transparent 60%), var(--panel); }
.contact-section h2 { margin: 14px 0; font-size: clamp(2rem, 4.5vw, 3.2rem); letter-spacing: -.07em; line-height: 1.14; }
.contact-section p { color: var(--muted); font-size: .88rem; }
.centered { justify-content: center; }
.footer { width: min(1080px, calc(100% - 44px)); margin: 0 auto; display: flex; justify-content: space-between; gap: 18px; padding: 22px 0 30px; border-top: 1px solid var(--line); color: #7f8ba7; font-size: .7rem; }
.footer a { color: #aeb8d0; }
.reveal { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } .reveal { opacity: 1; transform: none; } }
@media (max-width: 900px) {
  .hero { gap: 32px; grid-template-columns: 1fr .8fr; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
  .project-card { gap: 24px; }
  .interest-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 680px) {
  .topbar { min-height: 72px; width: calc(100% - 32px); }
  .menu-toggle { display: block; }
  .nav-links { display: none; position: absolute; top: 64px; left: 16px; right: 16px; z-index: 5; flex-direction: column; align-items: stretch; gap: 0; padding: 8px; border: 1px solid var(--line); border-radius: 14px; background: #11182b; box-shadow: 0 15px 40px rgba(0,0,0,.3); }
  .nav-links.open { display: flex; }
  .nav-links a { padding: 11px 12px; border-radius: 8px; }
  .nav-links a:hover { background: rgba(255,255,255,.04); }
  .section-shell { width: calc(100% - 32px); }
  .hero { display: flex; flex-direction: column; align-items: stretch; padding-top: 62px; padding-bottom: 58px; gap: 36px; }
  h1 { font-size: clamp(2.65rem, 13vw, 4rem); }
  .hero-card { min-height: 0; padding: 28px; }
  .quick-facts { gap: 20px; margin-top: 35px; }
  .fact-label { max-width: 100px; }
  .content-section { padding-top: 35px; padding-bottom: 35px; }
  .skills-grid, .qualification-grid, .project-card { grid-template-columns: 1fr; }
  .project-card { padding: 17px; }
  .project-visual { min-height: 280px; }
  .project-points { grid-template-columns: 1fr; }
  .interest-grid { grid-template-columns: repeat(2, 1fr); }
  .about-panel { padding: 22px; gap: 15px; }
  .contact-section { margin-top: 50px; margin-bottom: 45px; padding: 38px 18px; }
  .footer { width: calc(100% - 32px); flex-wrap: wrap; }
}
